{
  "name": "relay-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply relay-chat-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply relay-chat-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "qrcode-generator": "^1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.160.1"
  }
}
